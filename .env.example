# =============================================================================
# First 90 Days — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
#
# Legend:
#   [required]  — must be set; the app will not function without it
#   [optional]  — has a safe default or enables an optional feature
# =============================================================================


# -----------------------------------------------------------------------------
# Convex (backend)
# https://docs.convex.dev/
# -----------------------------------------------------------------------------

# [required] Your Convex deployment URL — visible in the Convex dashboard.
# e.g. https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# [required] Same Convex deployment URL, used server-side for auth config.
# Must match NEXT_PUBLIC_CONVEX_URL.
CONVEX_SITE_URL=https://your-deployment.convex.cloud


# -----------------------------------------------------------------------------
# Next.js application
# -----------------------------------------------------------------------------

# [required] Publicly accessible URL of this app.
# Used to build Stripe redirect/webhook callback URLs.
# Missing this in production will silently redirect Stripe callbacks to
# localhost:3000 — subscriptions will appear to hang.
NEXT_PUBLIC_APP_URL=https://your-app.example.com


# -----------------------------------------------------------------------------
# Stripe (billing)
# https://stripe.com/docs
# -----------------------------------------------------------------------------

# [required] Stripe secret key — sk_live_... (prod) or sk_test_... (dev)
STRIPE_SECRET_KEY=sk_test_...

# [required] Stripe webhook signing secret — whsec_...
# Create an endpoint in the Stripe dashboard pointing to:
#   POST /api/billing/webhook
# or use the Stripe CLI for local dev: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# [required] Stripe Price ID for the monthly Pro plan — price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# [required] Stripe Price ID for the annual Pro plan — price_...
STRIPE_PRICE_PRO_ANNUAL=price_...


# -----------------------------------------------------------------------------
# AI providers
# Text generation is pluggable via AI_PROVIDER; embeddings always use OpenAI.
# -----------------------------------------------------------------------------

# [optional] Which AI provider to use for text generation.
# Accepted values: "claude" (default) or "openai"
AI_PROVIDER=claude

# [required] Anthropic API key — used when AI_PROVIDER=claude (the default).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# [required] OpenAI API key — required for embeddings regardless of AI_PROVIDER.
# Embeddings are pinned to text-embedding-3-small; switching this off would
# require re-embedding all knowledge-base documents.
# https://platform.openai.com/
OPENAI_API_KEY=sk-...


# -----------------------------------------------------------------------------
# Resend (transactional email)
# https://resend.com/docs
# Used for email verification, password reset, and other auth emails.
# Without these the auth flows still complete, but codes are logged to the
# server console instead of being delivered — fine for local dev, broken
# for real users.
# -----------------------------------------------------------------------------

# [required in prod] Resend API key — re_...
# Set as a Convex env var (via `npx convex env set AUTH_RESEND_KEY ...`)
# so backend auth flows can deliver verification and reset codes.
AUTH_RESEND_KEY=re_...

# [optional] From-address used on every auth email. Must be a verified
# Resend sender. Defaults to Resend's shared onboarding address, which
# only works for testing.
AUTH_EMAIL="First90 <onboarding@resend.dev>"


# -----------------------------------------------------------------------------
# Upstash Redis (distributed rate limiting)
# https://upstash.com/docs/redis
# When both vars are set the proxy rate limiter uses Redis instead of
# an in-memory Map, so rate limits work across all serverless instances.
# Without them the app still functions — it just falls back to in-memory.
# -----------------------------------------------------------------------------

# [optional] Upstash Redis REST URL.
UPSTASH_REDIS_REST_URL=

# [optional] Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# Beehiiv (newsletter / waitlist)
# https://developers.beehiiv.com/
# Optional — only needed if the waitlist signup feature is enabled.
# -----------------------------------------------------------------------------

# [optional] Beehiiv API key for newsletter subscriptions.
BEEHIIV_API_KEY=

# [optional] Beehiiv publication ID — pub_...
BEEHIIV_PUBLICATION_ID=
